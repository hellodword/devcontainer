{
    "name": "Web3 Dev Prebuilt Devcontainer Image",
    "image": "mcr.microsoft.com/devcontainers/cpp:debian-12",
    "features": {
        "ghcr.io/devcontainers/features/common-utils": {},
        "ghcr.io/hellodword/devcontainer/common": {},
        "ghcr.io/devcontainers/features/go:1": {},
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts",
            "nodeGypDependencies": true,
            "installYarnUsingApt": false
        },
        "ghcr.io/devcontainers/features/rust:1": {},
        "ghcr.io/devcontainers/features/python:1": {},
        "ghcr.io/hellodword/devcontainer/k6": {},
        "ghcr.io/hellodword/devcontainer/solana": {}
    },
    "customizations": {
        "vscode": {
            "extensions": ["dbaeumer.vscode-eslint"]
        }
    }
}
